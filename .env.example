# Example environment configuration for Prompt Manage.
# Copy to ".env" and adjust. NEVER commit your real .env / SECRET_KEY.

# --- Core ---------------------------------------------------------------------
# Compose image tag or digest. Prefer a release/sha tag or digest in production.
PROMPT_MANAGE_IMAGE=ghcr.io/gzc888/prompt-manage:sha-REPLACE_ME
# Published host bind. Keep loopback when a reverse proxy shares the host/network.
HOST_BIND=127.0.0.1
# Published host port (the container always listens on APP_PORT below).
HOST_PORT=3501
# production | development | testing. docker-compose.yml intentionally pins
# production. Export APP_ENV manually for source runs; a custom Compose override
# may choose to pass this .env value through.
APP_ENV=production
# Port the app listens on (host port mapping is in docker-compose.yml).
APP_PORT=3501
# Path to the SQLite database file. In Docker this must be an absolute path inside
# /app/data; persist the whole /app/data directory. Import backups are stored under
# dirname(DB_PATH)/backups rather than at a separate fixed path.
DB_PATH=/app/data/data.sqlite3

# --- Security (REQUIRED in production) ----------------------------------------
# Generate a strong random key:  openssl rand -hex 32
# The app REFUSES to start in production if this is missing/empty/"dev-secret".
SECRET_KEY=replace-me-with-a-long-random-string

# REQUIRED before claiming a brand-new production database at /setup. An empty
# value leaves setup disabled (503); there is no passwordless first-run path.
# Generate a separate value with `openssl rand -hex 32`. It is never stored in
# SQLite. Leave empty only after setup is complete; an empty value keeps a fresh
# production database closed with HTTP 503. Remove this line's value and restart
# after setup is complete.
BOOTSTRAP_TOKEN=

# --- Session / cookies --------------------------------------------------------
# true when served over HTTPS (recommended on a public VPS).
SESSION_COOKIE_SECURE=true
# Lax (default) | Strict | None
SESSION_COOKIE_SAMESITE=Lax
# Only enable when the app is exclusively reached through exactly one trusted
# proxy that overwrites X-Forwarded-For and X-Forwarded-Proto. Never expose the
# application port directly while this is enabled.
TRUST_PROXY_HEADERS=false
# How long a login lasts. Default keeps the owner logged in ~10 years.
PERMANENT_SESSION_DAYS=3650

# --- Brute-force protection (per IP + route) ----------------------------------
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOCK_SECONDS=900

# --- Global brute-force protection (distributed attack guard) -----------------
# Failure count across all IPs/routes inside the global window.
GLOBAL_LOGIN_MAX_ATTEMPTS=1000
GLOBAL_LOGIN_WINDOW_SECONDS=3600

# --- Upload limits ------------------------------------------------------------
MAX_IMPORT_SIZE_MB=10
MAX_IMAGE_SIZE_MB=5
IMPORT_BACKUP_RETENTION=20

# --- Gunicorn ---------------------------------------------------------------
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_LOG_LEVEL=info

# --- Response hardening -------------------------------------------------------
# Emit security headers + a compatible Content-Security-Policy.
ENABLE_SECURITY_HEADERS=true
# Emit Strict-Transport-Security only for requests the app recognizes as HTTPS.
# This does not provide TLS by itself; terminate HTTPS at a trusted proxy first.
ENABLE_HSTS=true
# HSTS lifetime in seconds (default: 365 days). Use 0 to ask browsers to clear it.
HSTS_MAX_AGE=31536000
# Add `includeSubDomains` only after every affected subdomain supports HTTPS.
HSTS_INCLUDE_SUBDOMAINS=false

# --- Local development only ---------------------------------------------------
# `python app.py` does not automatically read this Compose .env file. Export
# FLASK_DEBUG=true in the shell to enable the reloader/debugger for a source run.
# NEVER enable it in production.
FLASK_DEBUG=false
